# =============================================================================
# Variables de entorno de nur-apigw
# =============================================================================

# --- Puertos publicados en el host -------------------------------------------
GATEWAY_HOST_PORT=8090
KEYCLOAK_HOST_PORT=8180

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_VERSION=26.4
# URL con la que se accede a Keycloak desde fuera (define el claim "iss")
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=nur
KEYCLOAK_CLIENT_ID=api-gateway
KEYCLOAK_CLIENT_SECRET=cambiar-por-un-secreto-largo

# Administrador de la consola de Keycloak (realm master)
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=cambiar-por-una-contrasena-segura

# --- PostgreSQL de Keycloak --------------------------------------------------
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=cambiar-por-una-contrasena-segura

# --- Usuarios de la aplicacion (realm nur) -----------------------------------
USERS_PASSWORD=Admin789456*