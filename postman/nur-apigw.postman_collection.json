{
  "info": {
    "name": "nur-apigw",
    "description": "API Gateway (Spring Cloud Gateway + Keycloak). Ejecutar primero 'Login': guarda el token en la variable {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8090" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"lhurtado\",\n  \"password\": \"Admin789456*\"\n}"
        },
        "url": "{{baseUrl}}/api/login"
      }
    },
    {
      "name": "Users",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "Posts",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/posts"
      }
    },
    {
      "name": "Users sin token (401)",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "url": "{{baseUrl}}/api/users"
      }
    }
  ]
}
